services:
  n8n:
    image: {{ n8n_n8n_docker_image }}
    container_name: n8n
    restart: unless-stopped
    security_opt:
      - no-new-privileges=true
    environment:
      - N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
      - N8N_HOST={{ n8n_fqdn }}
      - N8N_PORT=5678
      - N8N_PROTOCOL=https
      - N8N_DIAGNOSTICS_ENABLED=false
      - NODE_ENV=production
      - N8N_RUNNERS_ENABLED=true
      - N8N_RUNNERS_MODE=external
      - N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
      - N8N_NATIVE_PYTHON_RUNNER=true
      - N8N_RUNNERS_STDLIB_ALLOW=*
      - N8N_RUNNERS_AUTH_TOKEN={{ n8n_auth_token }}
      - WEBHOOK_URL=https://{{ n8n_fqdn }}/
      - GENERIC_TIMEZONE={{ timezone }}
      - TZ={{ timezone }}
    ports:
      - 127.0.0.1:5678:5678
    volumes:
      - /mnt/docker/volumes/n8n/data:/home/node/.n8n
    networks:
      - n8n
      - cloudflared
      - diun
    labels:
      - traefik.enable=true
      - traefik.http.routers.n8n.rule=Host(`{{ n8n_fqdn }}`)
      - traefik.http.routers.n8n.service=n8n
      - traefik.http.routers.n8n.entrypoints=websecure
      - traefik.http.routers.n8n.tls=true
      - traefik.http.routers.n8n.tls.certresolver=cloudflareResolver
      - traefik.http.services.n8n.loadbalancer.server.port=5678
      - diun.enable=true

  n8n-runners:
    build:
      context: .
      dockerfile: Dockerfile.runners
    image: n8nio/runners:latest-allow-all
    container_name: n8n-runners
    restart: unless-stopped
    security_opt:
      - no-new-privileges=true
    environment:
      - N8N_RUNNERS_TASK_BROKER_URI=http://n8n:5679
      - N8N_RUNNERS_AUTH_TOKEN={{ n8n_auth_token }}
      - N8N_DIAGNOSTICS_ENABLED=false
      - N8N_RUNNERS_STDLIB_ALLOW=*
      - N8N_RUNNERS_EXTERNAL_ALLOW=*
      - N8N_RUNNERS_PYTHON_STDLIB_ALLOW=*
      - N8N_RUNNERS_PYTHON_EXTERNAL_ALLOW=*
      - NODE_ENV=production
      - GENERIC_TIMEZONE={{ timezone }}
      - TZ={{ timezone }}
    depends_on:
      - n8n
    networks:
      - n8n

networks:
  n8n:
    external: true
  cloudflared:
    external: true
  diun:
    external: true
